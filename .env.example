# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- App ---
ENVIRONMENT=development
APP_SECRET_KEY=change-me

# --- Postgres ---
POSTGRES_USER=odoo_tms
POSTGRES_PASSWORD=change-me
POSTGRES_DB=odoo_tms
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://odoo_tms:change-me@postgres:5432/odoo_tms

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- Fernet encryption key for Odoo credentials at rest ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:5173

# --- Frontend (build-time) ---
VITE_API_BASE_URL=/api
